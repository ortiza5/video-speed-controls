{
  "name": "Video Speed Control",
  "description": "Why not speed up the world? Change the playback speed of HTML5 video players.",
  "version": "1.5",
  "manifest_version": 3,
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "match_about_blank": true,
      "js": ["js/content.js"],
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_icon": {
      "19": "img/icon-19.png",
      "38": "img/icon-38.png"
    },
    "default_title": "Change video speed",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "img/icon-128.png",
    "48": "img/icon-48.png",
    "16": "img/icon-16.png"
  }
}
